# Supabase — Project Settings > API sayfasından alınır
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Sadece scripts/run-migrations.mjs için gerekli (Project Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# OpenAI — sohbet (mülakatçı), Whisper (ses->metin) ve TTS (metin->ses) için
OPENAI_API_KEY=sk-xxx

# Deploy edilen sitenin tam adresi (feedback sayfasının kendi API'sini çağırabilmesi için)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# iyzico — abonelik (SaaS) sistemi için (Türkiye'de çalışır)
IYZICO_API_KEY=sandbox-xxx
IYZICO_SECRET_KEY=sandbox-xxx
IYZICO_URI=https://sandbox-api.iyzipay.com
# `npm run iyzico:setup` çalıştırılınca üretilir
IYZICO_PRICING_PLAN_REFERENCE_CODE=
